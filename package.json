{
  "name": "devhub",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && pnpm -F @devhub/bridge typecheck && tsc --noEmit -p shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "tauri": "tauri",
    "api:sync": "node scripts/sync-herdr-schema.ts",
    "api:check": "node scripts/sync-herdr-schema.ts --check",
    "bridge": "pnpm -F @devhub/bridge dev",
    "bridge:start": "pnpm -F @devhub/bridge start",
    "test:bridge": "pnpm -F @devhub/bridge test",
    "cli:install": "pnpm cli:build && mkdir -p \"$HOME/.local/bin\" && cp bridge/dist/devhub \"$HOME/.local/bin/devhub\" && echo \"installed devhub \u2192 ~/.local/bin/devhub\"",
    "cli:build": "pnpm -F @devhub/bridge build:cli",
    "icons": "bash scripts/icons.sh",
    "ios:build": "bash scripts/icons.sh && tauri ios build --export-method debugging",
    "web:build": "tsc && vite build --base ./ --outDir dist-web"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.1",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@devhub/shared": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.5",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
